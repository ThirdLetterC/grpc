  find_package(zstd CONFIG QUIET)
  if(TARGET zstd::libzstd)
    set(GRPC_ZSTD_FOUND TRUE)
    set(GRPC_ZSTD_TARGET zstd::libzstd)
  elseif(TARGET zstd::libzstd_shared)
    set(GRPC_ZSTD_FOUND TRUE)
    set(GRPC_ZSTD_TARGET zstd::libzstd_shared)
  elseif(TARGET zstd::libzstd_static)
    set(GRPC_ZSTD_FOUND TRUE)
    set(GRPC_ZSTD_TARGET zstd::libzstd_static)
  else()
    grpc_pkg_check_modules(ZSTD_PC QUIET IMPORTED_TARGET libzstd)
    if(ZSTD_PC_FOUND)
      set(GRPC_ZSTD_FOUND TRUE)
      set(GRPC_ZSTD_TARGET PkgConfig::ZSTD_PC)
    else()
      find_path(ZSTD_INCLUDE_DIR zstd.h)
