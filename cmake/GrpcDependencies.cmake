if(_tls_backend STREQUAL "auto")
  find_package(OpenSSL QUIET)
  if(OpenSSL_FOUND)
    set(_tls_backend openssl)
  else()
    set(_tls_backend none)
  endif()
endif()
set(GRPC_TLS_LIBRARIES)
set(GRPC_TLS_SOURCE)
set(GRPC_TLS_ENABLED FALSE)
if(NOT _tls_backend STREQUAL "none")
  if(_tls_backend STREQUAL "openssl" OR _tls_backend STREQUAL "libressl" OR
     _tls_backend STREQUAL "boringssl" OR _tls_backend STREQUAL "awslc")
    if(NOT TARGET OpenSSL::SSL OR NOT TARGET OpenSSL::Crypto)
      find_package(OpenSSL REQUIRED)
    endif()
    set(GRPC_TLS_SOURCE src/grpc_tls_openssl.c)
    set(GRPC_TLS_LIBRARIES OpenSSL::SSL OpenSSL::Crypto)
  elseif(_tls_backend STREQUAL "wolfssl")
    grpc_pkg_check_modules(WOLFSSL REQUIRED IMPORTED_TARGET wolfssl)
    set(GRPC_TLS_SOURCE src/grpc_tls_wolfssl.c)
    set(GRPC_TLS_LIBRARIES PkgConfig::WOLFSSL)
  elseif(_tls_backend STREQUAL "gnutls")
    grpc_pkg_check_modules(GNUTLS REQUIRED IMPORTED_TARGET gnutls)
    set(GRPC_TLS_SOURCE src/grpc_tls_gnutls.c)
    set(GRPC_TLS_LIBRARIES PkgConfig::GNUTLS)
  elseif(_tls_backend STREQUAL "rustls")
    if(WIN32)
      message(FATAL_ERROR "The rustls backend is currently supported only on Unix; use OpenSSL on Windows")
    endif()
    find_path(RUSTLS_INCLUDE_DIR rustls.h REQUIRED)
    find_library(RUSTLS_LIBRARY NAMES rustls REQUIRED)
    set(GRPC_TLS_SOURCE src/grpc_tls_rustls.c)
    set(GRPC_TLS_LIBRARIES "${RUSTLS_LIBRARY}" gcc_s util rt m dl)
  endif()
  set(GRPC_TLS_ENABLED TRUE)
endif()

set(GRPC_ALLOCATOR_LIBRARIES)
set(GRPC_ALLOCATOR_DEFINE "")
if(GRPC_ALLOCATOR STREQUAL "mimalloc")
  find_library(MIMALLOC_LIBRARY NAMES mimalloc REQUIRED)
  set(GRPC_ALLOCATOR_DEFINE GRPC_USE_MIMALLOC)
  set(GRPC_ALLOCATOR_LIBRARIES "${MIMALLOC_LIBRARY}")
elseif(GRPC_ALLOCATOR STREQUAL "jemalloc")
  if(MSVC)
    message(FATAL_ERROR "The jemalloc allocator is currently supported only on Unix; use default or mimalloc with MSVC")
  endif()
  find_library(JEMALLOC_LIBRARY NAMES jemalloc REQUIRED)
  set(GRPC_ALLOCATOR_DEFINE GRPC_USE_JEMALLOC)
  set(GRPC_ALLOCATOR_LIBRARIES "${JEMALLOC_LIBRARY}")
elseif(NOT GRPC_ALLOCATOR STREQUAL "default")
  message(FATAL_ERROR "GRPC_ALLOCATOR must be default, mimalloc, or jemalloc")
endif()

