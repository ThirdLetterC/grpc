set(GRPC_PROTOBUF_C_FOUND FALSE)
if(GRPC_PROTOBUF_C STREQUAL "ON" OR GRPC_PROTOBUF_C STREQUAL "AUTO")
  find_program(PROTOC_C_EXECUTABLE protoc-c)
  find_path(PROTOBUF_C_INCLUDE_DIR protobuf-c/protobuf-c.h HINTS "$ENV{HOME}/.local/include" "$ENV{HOME}/.local/usr/include")
  find_library(PROTOBUF_C_LIBRARY NAMES protobuf-c HINTS "$ENV{HOME}/.local/lib" "$ENV{HOME}/.local/usr/lib" "$ENV{HOME}/.local/usr/lib/x86_64-linux-gnu")
  if(PROTOBUF_C_INCLUDE_DIR AND PROTOBUF_C_LIBRARY)
    add_library(grpc_protobuf_c UNKNOWN IMPORTED)
    set_target_properties(grpc_protobuf_c PROPERTIES IMPORTED_LOCATION "${PROTOBUF_C_LIBRARY}" INTERFACE_INCLUDE_DIRECTORIES "${PROTOBUF_C_INCLUDE_DIR}")
    set(GRPC_PROTOBUF_C_TARGET grpc_protobuf_c)
    set(GRPC_PROTOBUF_C_FOUND TRUE)
  endif()
  if(NOT PROTOC_C_EXECUTABLE)
    set(GRPC_PROTOBUF_C_FOUND FALSE)
  endif()
  if(GRPC_PROTOBUF_C STREQUAL "ON" AND NOT GRPC_PROTOBUF_C_FOUND)
    message(FATAL_ERROR "protobuf-c and protoc-c are required when GRPC_PROTOBUF_C=ON")
  endif()
endif()
grpc_feature_enabled(PROTOBUF_C "${GRPC_PROTOBUF_C_FOUND}" "protobuf-c and protoc-c")

