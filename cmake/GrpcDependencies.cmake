        set_target_properties(grpc_zstd PROPERTIES IMPORTED_LOCATION "${ZSTD_LIBRARY}" INTERFACE_INCLUDE_DIRECTORIES "${ZSTD_INCLUDE_DIR}")
        set(GRPC_ZSTD_TARGET grpc_zstd)
