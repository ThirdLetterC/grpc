function(grpc_feature_enabled feature found description)
  string(TOUPPER "${GRPC_${feature}}" setting)
  if(setting STREQUAL "ON" AND NOT found)
    message(FATAL_ERROR "${description} was requested but its dependency was not found")
  endif()
  if(setting STREQUAL "OFF")
    set(enabled FALSE)
  elseif(found)
    set(enabled TRUE)
  else()
    set(enabled FALSE)
  endif()
  set(GRPC_${feature}_ENABLED "${enabled}" PARENT_SCOPE)
endfunction()

grpc_pkg_check_modules(NGHTTP2 QUIET IMPORTED_TARGET libnghttp2)
if(NOT NGHTTP2_FOUND)
  find_path(NGHTTP2_INCLUDE_DIR nghttp2/nghttp2.h HINTS "$ENV{HOME}/.local/include" "$ENV{HOME}/.local/usr/include")
  find_library(NGHTTP2_LIBRARY NAMES nghttp2 HINTS "$ENV{HOME}/.local/lib" "$ENV{HOME}/.local/usr/lib" "$ENV{HOME}/.local/usr/lib/x86_64-linux-gnu")
  if(NOT NGHTTP2_INCLUDE_DIR OR NOT NGHTTP2_LIBRARY)
    message(FATAL_ERROR "libnghttp2 development headers and library are required")
  endif()
  add_library(grpc_nghttp2 UNKNOWN IMPORTED)
  set_target_properties(grpc_nghttp2 PROPERTIES IMPORTED_LOCATION "${NGHTTP2_LIBRARY}" INTERFACE_INCLUDE_DIRECTORIES "${NGHTTP2_INCLUDE_DIR}")
  set(GRPC_NGHTTP2_TARGET grpc_nghttp2)
else()
  set(GRPC_NGHTTP2_TARGET PkgConfig::NGHTTP2)
endif()
find_package(libuv CONFIG QUIET)
